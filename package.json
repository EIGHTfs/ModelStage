{
  "name": "modelstage",
  "version": "0.4.2",
  "description": "Spine / Live2D 模型查看器：三级名册、两套渲染面共享相机与面板、UnityFS 资源包解包",
  "type": "module",
  "bin": {
    "modelstage": "bin/modelstage.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/modelstage.mjs",
    "test": "node --test test/*.test.mjs",
    "check:pack": "node tool/check-pack-boundary.mjs",
    "prepublishOnly": "npm run check:pack && npm run test"
  },
  "files": [
    "bin/",
    "src/server/",
    "src/shared/",
    "src/web/",
    "plugins/unity-live2d-bundle/",
    "plugins/unity-spine-bundle/",
    "tool/parse-jsonc.mjs",
    "tool/resolve-live2d-runtimes.mjs",
    "tool/lib/",
    "tool/spine-motion-rules.json",
    "config/plugins.json",
    "config/models/",
    "config/names/",
    "config/resources.example.json",
    "config/diag-upload.example.json",
    "README.md",
    "LICENSE",
    "!**/.trash/",
    "!**/.tmp-*",
    "!**/*.bak"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/ModelStage.git"
  },
  "homepage": "https://github.com/EIGHTfs/ModelStage#readme"
}
