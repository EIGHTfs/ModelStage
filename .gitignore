# 依赖与缓存
node_modules/
.pnpm-store/

# 编辑/系统
.DS_Store
Thumbs.db
*.swp

# 日志
*.log

# 进程 PID 文件（启停脚本生成，不入库）
*.pid

# 临时产物
tmp/
.trash/

# ---- 刻意排除：Spine 运行时源码（3.2MB）----
# 合规原因：Spine Runtimes 受 Esoteric Software 自定义协议约束，不纳入本仓库。
# 由 tool/resolve-runtimes.mjs 在构建时自动探测获取（环境变量 / 项目内 / 工作区共享 / 基线兜底）。
src/spine-runtimes/

# ---- 刻意排除：Live2D 运行时（与 src/spine-runtimes 并列、同理）----
# 合规原因（比 Spine 更硬）：Live2D Cubism Core / Cubism 2 运行时受
#   Live2D Proprietary Software License Agreement 约束 —— 文件头自称 "Redistributable Code"，
#   那是"允许随你的应用分发"，不等于可以放进公开源码仓库对外再分发；
#   pixi.js / pixi-live2d-display 虽是 MIT，但整目录排除更一致，避免"半个目录入库"。
# 由 tool/resolve-live2d-runtimes.mjs 探测获取：项目内版本化子目录 → 工作区共享 → 外部兜底；
#   多版本（v6-6.5.3 / v8-8.19.0）由 pixi 主版本优选。
src/live2d-runtimes/

# ---- 刻意排除：运行时诊断数据（只忽略运行产物，不整目录忽略）----
# data/diag.jsonl 是前端诊断探针经 POST /api/diag 追加写入的运行期日志（8 MB 轮转，可随时重建），
# 属运行产物不入库；需要取证时直接读本机文件即可。
#
# 为什么不用 `data/` 或 `/data/` 整目录忽略：
#   ① 不带前导斜杠的 `data/` 会匹配任意层级的 data 目录，把源码目录 `src/server/data/` 一起忽略，
#      实测导致该目录的改动提交时报 "src/server/data is ignored" 并返回非零；
#   ② 即便加上前导斜杠（`/data/`），也会盖住**需要入库**的 `data/` 下其它路径，
#      使它们的后续修改不被 git add 捕获（`git ls-files -ci --exclude-standard` 可查出来）。
#   所以只逐项忽略真正属于运行产物/大体积数据的路径。
/data/diag.jsonl
/data/diag.jsonl.*
/data/bug-shots/
# 服务端解包落盘缓存（17b）：可重建（源包 + 插件版本变了就失效），不入库。
#   注意逐项写死路径，不用 data/ 或 /data/ 通配 —— 那会连带忽略 src/server/data/
/data/unpacked/
/data/export/
# 上游游戏原始数据快照（名表导入的原料）：体积 17MB / 113 万行，远大于项目其余全部内容，
#   且随游戏版本变化、可由导入脚本重新获取 ⇒ 属外部数据而非源码，不入库。
#   换机/重建名表时需要单独带走该目录，见 data/upstream/README.md。
/data/upstream/
# 用户上传的主题背景图（运行时数据）：内容由用户产生、体积不可控，
#   属部署侧数据而非源码，不入库；换机/备份需单独带走该目录。
/data/backgrounds/
/data/logs/

# ---- 刻意排除：部署侧本地配置 .env ----
# 原因：.env 按约定是"本机部署差异"的载体（顶部栏标题/图标等），且该文件名会被审计规则
#   判定为凭据/密钥文件而拒绝入库。需要的键与取值说明见随仓库入库的 .env.example，
#   本地复制成 .env 再改即可；服务端每次请求重新读取，改完刷新页面生效。
.env
.env.local

# ---- 刻意排除：构建产物 dist/index.html ----
# 原因：产物内联了 Spine 运行时源码，入库等于又把运行时带回仓库（违背上面的合规目的）。
# 需要交付时用 node tool/build.mjs 现生成即可。
dist/

# ---- 刻意排除：自动生成的资源清单 ----
# config/models/<spine|live2d>.<rootId>.json 是服务端扫描资源目录后落盘的索引（可随时重建，
# 类似构建产物），不入库。
config/models/
config/*.tmp

# ---- 刻意排除：用户配置（本机相关，换机器即失效）----
# config/resources.json 存的是**本机绝对路径**的资源根列表，换设备后不适用，
# 所以不入库；首次运行由服务端生成空模板，配置方式见 config/resources.example.json。
config/resources.json

# ---- 刻意排除：名表（上游数据，待重新设计后再定归属）----
# config/names/<游戏完整中文名>.json 是手工维护的名表数据（体积大、与代码历史无关）。
#   实际内容存在 names 分支；主分支只留忽略规则。取用：git checkout names -- config/names
# 缺失时不影响模型加载与渲染，只是回退显示拼音目录名、没有图标。
config/names/

# 导入配置时的自动备份（应急恢复用，不入库；轮换后旧的移入 config/.trash/）
config/.bak-*/

# ---- 注意：以下刻意入库 ----
#   config/  tool/       配置与工具脚本
# 游戏提取资源（.skel/.atlas/.png 等）一律不入库 —— 见 README 合规说明

# ---- 构建必需的原始字节（不入库：内容源自原版单文件，本地保留即可构建与校验）----

# ---- 运行时产物（启停脚本生成，不入库）----
runtime/

# 会话插话提出的新功能记录（项目约定不入库）
任务.md

# 任务列表（工作台状态：当前还有哪些活 + 每项怎么做，不是项目资产）
任务列表.md

# ---- 头像仓（独立私有仓，本机克隆目录；不进主项目仓）----
# 头像 png 是二进制大文件，放主仓会把仓吹大、每次换图都产生不可读 diff。
# 主仓只在 config/index/*.index.json 里存 avatar 文件名（见 docs/设计/名表.md §四 / D2）。
avatars/
node_modules.orig/
