# 品牌配置（网页标题 + 顶部栏标题/图标）—— 模板文件
#
# 用法：把本文件复制为 .env（同目录）再改。.env 已被 .gitignore 忽略，不会入库。
#   服务端每次请求重新读取 .env，改完**刷新页面**即生效，无需重启服务。
#   读取入口：GET /api/brand（由 server.mjs 的 readDotEnv() 零依赖解析）。
#
# 两键都可留空/删除：留空时保持产物里内置的默认值。

# APP_TITLE —— 同时用于两处：
#   ① 浏览器标签页标题（<title>）：服务端在返回首页时就替换好，页签不闪旧值
#   ② 顶部栏标题文字
#   留空 = 保持产物内置标题与顶部栏默认文案。
APP_TITLE=

# APP_ICON —— 顶部栏图标。三种取值：
#   留空                          = 保持产物内置图标（lucide sparkles）
#   http(s)/data: 或以图片扩展名结尾的路径 = 当图片用（<img>）
#   其它任意文字（如 emoji 🎬）    = 当文字/emoji 用
APP_ICON=

# ── 前端行为开关 ──────────────────────────────────────────────────────────
# 读取入口：GET /api/web-config（与 /api/brand 同一套 .env、同样每次请求重读）。
# 取值统一为 true/false，也接受 1/0、on/off、yes/no；
# 留空或删除 = 未配置，由前端回落到自身默认值（服务端不替前端决定默认行为）。

# AUTO_RESTORE_LAST —— 启动时是否自动恢复上次选中的模型（并展开其所属游戏/角色）。
#   1/true  = 恢复（与旧版行为一致，未配置时的默认值）
#   0/false = 每次进入都是空舞台，需手动点选
AUTO_RESTORE_LAST=1

