{
  "id": "unity-live2d-bundle",
  "name": "Unity Live2D 资源包",
  "provides": [
    "asset-provider"
  ],
  "label": "Live2D包",
  "accent": "#6d28d9",
  "matchPriority": 10,
  "version": 1,
  "runtime": "node",
  "entry": "index.js",
  "fileKinds": [
    "bundle"
  ],
  "produces": {
    "kind": "live2d",
    "entry": "resolve(file)",
    "schema": "docs/契约/插件.md",
    "fields": [
      "prefix",
      "files",
      "entry"
    ],
    "note": "resolve(file) 按资产提供者契约 §1.2 返回 { prefix, files, entry }：prefix 形如 vfs://unity-live2d-bundle/<rootId>/<相对目录>/，files 为 relPath→Blob|string 映射，entry 是 files 内的渲染入口键",
    "memory": {
      "via": "estimateMemory(file)",
      "fields": [
        "decompressedBytes",
        "rgbaBytes",
        "peakBytes"
      ],
      "supported": [
        "decompressedBytes",
        "peakBytes"
      ],
      "note": "returns { decompressedBytes, peakBytes }: decompressedBytes comes from the container block table (no inflate); peakBytes comes from this plugin's own segmented model (measured max x1.15 per bucket). rgbaBytes is backfilled into data/unpacked/<fp>/probe.json after a real resolve"
    }
  },
  "errorCodes": [
    "ULB_ERR_BAD_ARGS",
    "ULB_ERR_NO_FILE",
    "ULB_ERR_IO",
    "ULB_ERR_NOT_UNITYFS",
    "ULB_ERR_NO_CAB",
    "ULB_ERR_CONTAINER_PARSE",
    "ULB_ERR_LZMA_FAIL",
    "ULB_ERR_LZMA_UNAVAILABLE",
    "ULB_ERR_EXTRACT",
    "ULB_ERR_TEX_FORMAT_UNSUPPORTED",
    "ULB_ERR_TEX_DATA_SHORT",
    "ULB_ERR_TEX_DECODE",
    "ULB_ERR_CURVE_BINDING_MISMATCH",
    "ULB_ERR_STREAMED_CLIP_INVALID",
    "ULB_ERR_MODEL_BUILD",
    "ULB_ERR_NO_HOST",
    "ULB_ERR_EXPORT_NO_SPACE",
    "ULB_ERR_EXPORT_INTERRUPTED"
  ],
  "files": [
    "lib/errors.js",
    "lib/bytes.js",
    "lib/common-strings.js",
    "lib/lzma-d-min.js",
    "lib/unityfs.js",
    "lib/serialized.js",
    "lib/typetree.js",
    "lib/extract.js",
    "lib/etc2.js",
    "lib/dxt.js",
    "lib/texdecode.js",
    "lib/bundle-probe.js",
    "lib/png.js",
    "lib/anim-to-motion.js",
    "lib/model3.js",
    "index.js"
  ],
  "assets": [
    "profiles/unityfs-live2d.json"
  ]
}
